{
  "schemaVersion": 1,
  "id": "clearvoid",
  "version": "${version}",
  "name": "Clear Void",
  "description": "Remove the black bottom part of the skybox. Intended for floating island worlds.",
  "authors": [
    "yezhiyi9670"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/clear-void",
    "sources": "https://github.com/yezhiyi9670/clear-void/"
  },
  "license": "MIT",
  "icon": "assets/clearvoid/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "yezhiyi9670.clearvoid.fabric.ExampleModFabric"
    ],
    "client": [
      "yezhiyi9670.clearvoid.fabric.client.ExampleModFabricClient"
    ]
  },
  "mixins": [
    "clearvoid.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.3",
    "minecraft": ">=1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "another-mod": "*"
  }
}
